LOSS=single-positive InfoNCE # 两组每行只把同位置 positive 作为正例。
MULTI_POSITIVE_TARGETS=0 # 固定为 0，保持 single-positive。
BATCH_SIZE=128 # 两组共同的单卡 batch size。
GRAD_ACCUM=1 # 两组共同的梯度累积步数。
GLOBAL_BATCH_SIZE=128 # 每次更新覆盖的 query 数。
MAX_LENGTH=4096 # 训练 query 和 positive 的 token 上限；预审计要求超限数为 0。
EPOCHS=4 # 两组都训练 4 轮。
LEARNING_RATE=2e-5 # 两组共同的 AdamW 学习率。
WEIGHT_DECAY=0.01 # 两组共同的权重衰减。
WARMUP_RATIO=0.03 # 两组共同的 warmup 比例。
TEMPERATURE_LOSS=0.05 # InfoNCE 相似度温度。
SAVE_STEPS=83 # 每 83 step 保存一次，约每轮一个 checkpoint。
SEED=42 # 数据顺序、DataLoader、初始化、训练和评测统一随机种子。
ATTN_IMPLEMENTATION=flash_attention_2 # 两组共同使用 FlashAttention 2。
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True # 减少长序列显存碎片。
CUDA_DEVICES=0 # 训练和评测使用的 A100 GPU。
EVAL_BATCH_SIZE=256 # 两组共同的评测编码 batch size。
EVAL_MAX_LENGTH=4096 # 评测 token 上限，与训练一致。
CANDIDATE_ITEMS=12000 # 两组使用相同 item_info 和候选顺序。
SEEN_ITEM_MASK=1 # 两组排序前屏蔽 history item 和 pad item。
SELECTION_METRIC=NDCG@20 # 两组分别只按 valid 指标选 checkpoint。
RUN_TEST=1 # valid 选模并冻结后是否各运行一次 development test。
RUN_TEST_ALL_CHECKPOINTS=1 # 是否在独立目录对每个 checkpoint 跑 test 诊断；诊断指标不得参与选模。
RUN_GENERATION=1 # 是否调用 GLM 生成 train、valid、test CoT。
RUN_TRAIN=1 # 是否训练并评测两组 retriever。
CONFIRM_RUN=1 # 必须为 1 才执行数据生成、API、训练或评测。
PRINT_ARGS_ONLY=0 # 为 1 时只打印本参数表。
