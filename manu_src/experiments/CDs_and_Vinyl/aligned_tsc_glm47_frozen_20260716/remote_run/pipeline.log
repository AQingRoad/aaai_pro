RATING_CONTEXT=no_rating # 所有 split 都按无评分 observed history 生成。
TEMPERATURE=0.6 # 每条 history 的唯一 CoT 采样温度。
TOP_P=0.9 # GLM nucleus sampling 参数。
NUM_CANDIDATES=1 # 每条 history 只生成一条 CoT。
MAX_OUTPUT_WORDS=1024 # tagged think 与 answer 的总词数上限。
MAX_NEW_TOKENS=2048 # API 最大输出 token 数。
RECORD_API_RAW=0 # 默认不保存完整 API raw response。
